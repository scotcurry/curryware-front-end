# Loaded by `npm run dev` only (never by `next build` / production).
# The public ingress route to curryware-java-api-server; Traefik strips /java.
# In the cluster this is set on the Deployment to the internal Service instead:
#   JAVA_API_BASE_URL=http://curryware-java-api-server-service:8080
JAVA_API_BASE_URL=https://ubuntu-microk8s.curryware.org/java
